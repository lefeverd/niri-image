## ~/.local
# no .local/bin: pip/pipx/uv tool links there point into venvs that don't come back
# (reinstall with `uv tool install`); CLI tools, claude included, come from the Brewfile
.local/share/applications
.local/share/Insync
.local/share/icons
.local/share/backgrounds
.local/share/k9s
.local/share/helm
.local/share/pki
.local/share/keyrings
.local/share/DBeaverData
.local/share/Euro Truck Simulator 2
.local/state/syncthing
.local/state/borgmatic
.local/state/DankMaterialShell

## apps now on Flatpak
.thunderbird => .var/app/org.mozilla.thunderbird/.thunderbird
.config/keepassxc => .var/app/org.keepassxc.KeePassXC/config/keepassxc
.config/remmina => .var/app/org.remmina.Remmina/config/remmina
.local/share/remmina => .var/app/org.remmina.Remmina/data/remmina
.config/darktable => .var/app/org.darktable.Darktable/config/darktable
.config/hexchat => .var/app/io.github.Hexchat/config/hexchat
.config/kicad => .var/app/org.kicad.KiCad/config/kicad
.local/share/kicad => .var/app/org.kicad.KiCad/data/kicad
